# LDI Platform - Environment Configuration
# Copy this file to .env and fill in your values

# Flask Secret Key (REQUIRED - generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-random-64-chars

# Database URL (PostgreSQL for production, leave empty for SQLite fallback)
DATABASE_URL=

# Debug mode (NEVER true in production)
FLASK_DEBUG=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://adeptai.pl,https://www.adeptai.pl

# Sentry DSN for error monitoring (optional)
SENTRY_DSN=

# Rate limiting storage (memory:// for dev, redis:// for production)
RATE_LIMIT_STORAGE=memory://

# Render deployment
PORT=5000
